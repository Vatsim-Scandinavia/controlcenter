{
    "name": "controlcenter/module-moodle",
    "description": "Adds a sidebar link to a Moodle instance configured per installation.",
    "license": "MIT",
    "type": "controlcenter-module",
    "require": {
        "php": ">=8.4 <8.6",
        "controlcenter/module-api": "@dev"
    },
    "autoload": {
        "psr-4": {
            "ControlCenter\\Modules\\Moodle\\": "src/"
        }
    },
    "extra": {
        "controlcenter": {
            "module": "ControlCenter\\Modules\\Moodle\\MoodleModule"
        }
    },
    "minimum-stability": "stable"
}
